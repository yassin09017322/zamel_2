{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Generate Isar code",
			"type": "shell",
			"command": "flutter pub get && flutter pub run build_runner build --delete-conflicting-outputs",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Analyze Flutter project",
			"type": "shell",
			"command": "flutter analyze",
			"args": [],
			"isBackground": false,
			"problemMatcher": [
				"$flutter-analyze"
			]
		},
		{
			"label": "Run Flutter app",
			"type": "shell",
			"command": "flutter run",
			"options": {
				"env": {
					"CLOUDFLARE_WORKER_URL": "${env:CLOUDFLARE_WORKER_URL}",
					"FIREBASE_API_KEY": "${env:FIREBASE_API_KEY}",
					"FIREBASE_APP_ID": "${env:FIREBASE_APP_ID}",
					"FIREBASE_MESSAGING_SENDER_ID": "${env:FIREBASE_MESSAGING_SENDER_ID}",
					"FIREBASE_PROJECT_ID": "${env:FIREBASE_PROJECT_ID}",
					"FIREBASE_STORAGE_BUCKET": "${env:FIREBASE_STORAGE_BUCKET}",
					"FIREBASE_AUTH_DOMAIN": "${env:FIREBASE_AUTH_DOMAIN}",
					"FIREBASE_MEASUREMENT_ID": "${env:FIREBASE_MEASUREMENT_ID}",
					"FIREBASE_ANDROID_APP_ID": "${env:FIREBASE_ANDROID_APP_ID}",
					"FIREBASE_IOS_APP_ID": "${env:FIREBASE_IOS_APP_ID}",
					"FIREBASE_MACOS_APP_ID": "${env:FIREBASE_MACOS_APP_ID}",
					"FIREBASE_WINDOWS_APP_ID": "${env:FIREBASE_WINDOWS_APP_ID}",
					"FIREBASE_LINUX_APP_ID": "${env:FIREBASE_LINUX_APP_ID}",
					"FIREBASE_IOS_BUNDLE_ID": "${env:FIREBASE_IOS_BUNDLE_ID}"
				}
			},
			"isBackground": false,
			"problemMatcher": []
		}
	]
}